    <!-- Location permission rationale -->
    <string name="location_permission_title">Location Permission Required</string>
    <string name="location_permission_body_1">Automations need location permission exclusively to read your Wi-Fi network name (SSID), so the app can detect when you join a specific network and wake your devices automatically.</string>
    <string name="location_permission_body_2">This is the only purpose for which location access is used. No location data is ever collected, stored, or shared.</string>
    <string name="location_permission_body_3">When prompted, select \"Allow all the time\" so automations can trigger even when the app is in the background.</string>

    <!-- Notification permission rationale shown once on first launch -->
    <string name="notification_permission_title">Allow Notifications</string>
    <string name="notification_permission_body_1">The Quick Settings tile shows a short message after every tap: whether the wake command was sent, whether no device is set up yet, or whether the network is wrong. On Android 13 and newer the system silently drops those messages while the app\'s notifications are turned off — which is exactly when the tile is used.</string>
    <string name="notification_permission_body_2">The same permission is also what makes the automation notifications visible, including the ongoing service notice.</string>
    <string name="notification_permission_body_3">No data is collected, stored, or shared. The permission is only used to display messages on this device.</string>
    <string name="notification_permission_confirm">Allow</string>
    <string name="notification_permission_cancel">Not now</string>

