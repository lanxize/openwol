    <!-- Help dialog -->
    <string name="help_title">Help</string>
    <string name="help_bios_title">1. BIOS Setup</string>
    <string name="help_bios_body">Enable \'Wake on LAN\' or \'Power On By PCI-E\' in your computer\'s BIOS settings.</string>
    <string name="help_windows_title">2. Windows Setup</string>
    <string name="help_windows_body">In Device Manager, go to your Network Adapter properties, in Advanced check \'Allow this device to wake the computer\', \'Wake on Magic Packet\' &amp; \'Wake on magic packet when system is in the S0ix power state\'.</string>
    <string name="help_linux_title">3. Linux Setup</string>
    <string name="help_linux_body">You already know how to do it.</string>
    <string name="help_network_title">4. Networking</string>
    <string name="help_network_body">If waking fails, use \'Advanced Settings\' in OpenWOL to specify your PC\'s IP and Subnet Mask.</string>
    <string name="help_warning">⚠️ It\'s best to set the IP address to avoid spamming your entire network range.</string>

