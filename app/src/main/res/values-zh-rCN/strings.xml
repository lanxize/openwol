    <!-- 帮助弹窗 -->
    <string name="help_title">帮助</string>
    <string name="help_bios_title">1. BIOS 设置</string>
    <string name="help_bios_body">在电脑 BIOS 中开启“Wake on LAN”或“Power On By PCI-E”。</string>
    <string name="help_windows_title">2. Windows 设置</string>
    <string name="help_windows_body">打开“设备管理器”→ 网络适配器属性 →“高级”标签页，勾选“允许此设备唤醒计算机”“魔术封包唤醒”和“在 S0ix 电源状态下使用魔术封包唤醒”。</string>
    <string name="help_linux_title">3. Linux 设置</string>
    <string name="help_linux_body">这个你应该比我熟。</string>
    <string name="help_network_title">4. 网络</string>
    <string name="help_network_body">如果唤不醒，请在 OpenWOL 的“高级设置”中填写电脑的 IP 地址和子网掩码。</string>
    <string name="help_warning">⚠️ 建议填写具体的 IP 地址，否则唤醒包会发往整个网段。</string>

    <!-- 关于弹窗 -->
    <string name="info_tagline">一款简洁、开源、注重隐私的 Android 局域网唤醒（Wake-on-LAN）应用。</string>
    <string name="info_privacy_title">隐私</string>
    <string name="info_privacy_body">不收集、不存储、不共享任何数据。应用完全离线运行，无需账号，也不需要联网。</string>
    <string name="info_source_title">源代码</string>
    <string name="info_libraries_title">使用的开源库</string>
    <string name="info_library_kotlin">• Kotlin — Apache 2.0（JetBrains）</string>
    <string name="info_library_compose">• Jetpack Compose — Apache 2.0（Google）</string>
    <string name="info_library_material">• Material Design 3 / 图标 — Apache 2.0（Google）</string>
    <string name="info_library_androidx">• AndroidX（Core、Lifecycle、SplashScreen）— Apache 2.0（Google）</string>
    <string name="info_library_serialization">• kotlinx.serialization — Apache 2.0（JetBrains）</string>
    <string name="info_library_icons">• Google Fonts 图标 — Apache 2.0（Google）</string>
    <string name="info_license_title">许可证</string>
    <!-- 用双引号包裹：否则 aapt 会裁掉结尾空格，中文会连成“基于GNU” -->
